# Copia este archivo como ".env" y rellena lo que necesites.

# --- Cerebros --------------------------------------------------------------
# Orden de preferencia: se usa el primero que responda. Sólo cuentan los que
# tengan clave ("local" sólo si Ollama está en marcha).
JARVIS_CEREBROS=claude,gemini,groq,local

# Gemini (GRATIS, rápido): https://aistudio.google.com/apikey
GEMINI_API_KEY=
JARVIS_MODELO_GEMINI=gemini-3.1-flash-lite

# Groq (GRATIS, ~50-70 preguntas al día; si hablas muy seguido, espera unos segundos):
# https://console.groq.com/keys
GROQ_API_KEY=
JARVIS_MODELO_GROQ=openai/gpt-oss-120b

# Claude (DE PAGO, el más listo): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
JARVIS_MODELO_CLAUDE=claude-sonnet-5
# Búsqueda web propia de Claude (mejor, pero 0,01 USD por búsqueda).
# Con "no" usa la búsqueda gratuita (DuckDuckGo), igual que los demás cerebros.
JARVIS_BUSQUEDA_WEB_CLAUDE=no

# Ollama (GRATIS, sin internet). Con 8 GB de RAM usa uno de ~3B: qwen2.5:3b, llama3.2:3b
JARVIS_MODELO_LOCAL=qwen2.5:3b

# --- Usuario ---------------------------------------------------------------
JARVIS_NOMBRE_USUARIO=
JARVIS_CIUDAD=Asunción
JARVIS_PAIS=PY
JARVIS_ZONA_HORARIA=America/Asuncion

# --- Idioma y voz ----------------------------------------------------------
# Idioma al arrancar: es (español latino) | en (inglés, como la versión original)
# En marcha se cambia diciendo "Jarvis, habla en inglés" / "Jarvis, speak Spanish".
JARVIS_IDIOMA=es
# Prueba las voces con:  iniciar_jarvis.bat --probar-voces
# Español: es-MX-JorgeNeural, es-US-AlonsoNeural, es-CO-GonzaloNeural, es-AR-TomasNeural
JARVIS_VOZ_ES=es-MX-JorgeNeural
JARVIS_TONO_ES=-4Hz
JARVIS_VELOCIDAD_ES=+0%
JARVIS_TRATAMIENTO_ES=señor
# Inglés: en-GB-RyanNeural, en-GB-ThomasNeural
JARVIS_VOZ_EN=en-GB-RyanNeural
JARVIS_TONO_EN=-2Hz
JARVIS_VELOCIDAD_EN=+0%
JARVIS_TRATAMIENTO_EN=sir

# --- Dispositivos de casa --------------------------------------------------
# Tele Samsung smart: IP y MAC (búscalas con: python -m jarvis --buscar-dispositivos).
# Conviene fijar la IP en el router (reserva DHCP) para que no cambie.
# La primera vez hay que aceptar el permiso en la tele: python -m jarvis --emparejar-tele
JARVIS_TELE_IP=
JARVIS_TELE_MAC=

# --- App del celular (android/) --------------------------------------------
# Nombre Bluetooth (o parte) de la radio del auto. La app muestra el nombre del
# dispositivo al que se conecta; ponlo aquí y vuelve a compilar.
JARVIS_RADIO_AUTO=

# --- Oído ------------------------------------------------------------------
# Micrófono: vacío = el predeterminado de Windows, o un número / parte del nombre.
# Lista: .venv\Scripts\python.exe -m sounddevice
JARVIS_MICROFONO=
# Palabra de activación de openWakeWord, o la ruta a un modelo .onnx propio
JARVIS_PALABRA_ACTIVACION=hey_jarvis
# Súbelo (0.6-0.7) si se activa solo; bájalo (0.3-0.4) si no te hace caso
JARVIS_UMBRAL_ACTIVACION=0.5
# tiny | base | small | medium  (más grande = entiende mejor pero tarda más)
JARVIS_MODELO_WHISPER=small
# Segundos que sigue escuchando tras responder, sin volver a decir "Jarvis"
JARVIS_SEGUNDOS_SEGUIMIENTO=6
